<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Magma</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <header>
        <nav id="navbar"> 
            <button class="navbar-item" onclick="location.href='http://localhost:3000/'">Home</button>
            <button class="navbar-item" onclick="location.href='http://localhost:3000/products'">Products</button>
            <button class="navbar-item" onclick="location.href='http://localhost:3000/about'">About</button>
        </nav>
    </header>
    <main>
        <div class="product-details-wrapper">
        <div class="product-details-image"><img src="images/<%= product[0].pictureurl %>" alt="<%= product[0].name %>">
        </div>
    <div class="product-details-content">
        <h1 class="product-details-title"><%= product[0].name %></h1>
        <div class="product-details-size">Размер: <%= product[0].size %></div>
        
    </div>
    <div class="product-details-price">€ <%= product[0].price %></div>
    </div>
</main>

</body>
</html>