# Path to the source Excel file
EXCEL_FILE_PATH=./data/products.xlsx

# Folder on disk where the original product photos already live.
# Used to recover each photo's real filename by matching file content.
IMAGES_FOLDER_PATH=../public/images

# Optional: name of the worksheet to read. Leave blank to use the first sheet.
SHEET_NAME=

# Row number of the header row (data starts on the next row). Default: 1
HEADER_ROW=2

# "hash"    (default) - match each embedded photo against a file already
#           in IMAGES_FOLDER_PATH by content hash, and store that file's
#           real filename in pictureurl.
# "extract" - don't try to match; just save each embedded photo into
#           IMAGES_FOLDER_PATH under a generated filename and store that
#           generated filename in pictureurl.
MATCH_MODE=hash

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=eithriela
DB_PASSWORD=h530n730
DB_NAME=magma
DB_TABLE=products
